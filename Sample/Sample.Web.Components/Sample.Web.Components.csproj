<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <RootNamespace>Sample.Web.Components</RootNamespace>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <SupportedPlatform Include="browser" />
    </ItemGroup>

    <ItemGroup>
        <!-- NotificationsSink maps the silo's POST target via minimal-API
             endpoint routing, so the RCL needs the ASP.NET hosting types
             (IEndpointRouteBuilder, Results) the Razor SDK does not pull in. -->
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <!-- Components and Components.Web ship in the Microsoft.AspNetCore.App
             framework reference above; only the static-assets package is a
             standalone reference the shared framework does not prune. -->
        <PackageReference Include="Microsoft.AspNetCore.App.Internal.Assets" />
    </ItemGroup>

    <ItemGroup>
        <!--
          The RCL binds to consumer contract types (commands, projection rows,
          dead-letter entries) and the framework's IEdictSender / repository
          interfaces. It is host-agnostic: any sample (Azure today, Kafka/Postgres
          tomorrow) can MapRazorComponents<App>() against this assembly.
        -->
        <ProjectReference Include="../Sample.Contracts/Sample.Contracts.csproj" />
        <ProjectReference Include="../Sample.Domain/Sample.Domain.csproj" />
        <ProjectReference Include="../../Edict/Edict.Core/Edict.Core.csproj" />
        <!-- The simulator's origin sends live here, so the analyzer must run here
             to dogfood EDICT023; this project's .editorconfig opts it on. -->
        <ProjectReference Include="../../Edict/Edict.Analyzers/Edict.Analyzers.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
    </ItemGroup>

</Project>
