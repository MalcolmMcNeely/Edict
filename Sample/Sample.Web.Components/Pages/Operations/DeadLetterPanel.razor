@inject IEdictDeadLetterRepository DeadLetterRepository
@implements IDisposable

@if (_entries.Count == 0)
{
    <p class="placeholder-note"><em>No dead-letter rows yet. Effects that exhaust the outbox retry budget land here; failure is forensic, not blocking.</em></p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Cause</th>
                <th>Dead-lettered at</th>
                <th>Kind</th>
                <th>Source grain</th>
                <th>Effect target</th>
                <th>Attempts</th>
                <th>Exception</th>
                <th>Reason</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var entry in _entries)
            {
                <tr>
                    <td><span class="dl-cause">@CauseLabel(entry)</span></td>
                    <td>@entry.DeadLetteredAt.ToString("HH:mm:ss")</td>
                    <td>@entry.Kind</td>
                    <td><code>@entry.SourceGrainType</code>/<code>@entry.SourceGrainKey</code></td>
                    <td><code>@entry.EffectTarget</code></td>
                    <td>@entry.AttemptCount</td>
                    <td>@entry.ExceptionType</td>
                    <td>@entry.Reason</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    IReadOnlyList<EdictDeadLetterEntry> _entries = [];

    PeriodicTimer? _timer;
    CancellationTokenSource? _cancellationTokenSource;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
        _cancellationTokenSource = new CancellationTokenSource();
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        _ = PollAsync(_cancellationTokenSource.Token);
    }

    async Task PollAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (await _timer!.WaitForNextTickAsync(cancellationToken))
            {
                await RefreshAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    async Task RefreshAsync()
    {
        try
        {
            _entries = await DeadLetterRepository.ListAllAsync();
        }
        catch
        {
            _entries = [];
        }
    }

    // The RCA distinction operators care about is what failed and why. A receiver
    // that lost its claim-check blob is its own category; otherwise the effect kind
    // names the cause, with the two demo-injected dead letters (an Event Handler that
    // threw, and a Command that exhausted retries on a rejecting target) called out by name.
    static string CauseLabel(EdictDeadLetterEntry entry) =>
        entry.FailureKind == EdictDeadLetterFailureKind.BlobMissing
            ? "Claim-check blob reaped"
            : entry.Kind switch
            {
                "InvokeHandler" => "Event handler threw",
                "SendCommand" => "Command rejected, retries exhausted",
                "PublishEvent" => "Event publish failed",
                "UpsertRow" => "Projection write failed",
                _ => entry.Kind,
            };

    public void Dispose()
    {
        _cancellationTokenSource?.Cancel();
        _timer?.Dispose();
        _cancellationTokenSource?.Dispose();
    }
}
