@page "/playground"
@using Edict.Contracts.Commands
@using Edict.Contracts.Sending
@using Sample.Contracts.Cart.Commands
@using Sample.Contracts.Cart.Projections
@using Sample.Contracts.Orders.Projections
@inject IEdictSender Sender
@inject IEdictTableRepository<CheckedOutCartRow> CheckedOutCarts
@inject IEdictTableRepository<OrderStatusRow> OrdersByStatus
@implements IDisposable

<PageTitle>Edict — Playground</PageTitle>

<h1>Playground</h1>

<p class="tagline">Step a workflow one Command at a time — each click is one trace in the Aspire dashboard, in contrast to the Demo hub's auto-traffic. Build a cart with state-only Commands (no Event, no downstream traffic), then check out: a bridge Saga turns the whole basket into an Order that flows through payment and fulfillment.</p>

<section class="hub-controls">
    <span class="playground-cart">Cart <code>@FormatShort(_cartId)</code></span>
    <span class="hub-controls-sep"></span>
    @foreach (var sku in Catalogue)
    {
        <button @onclick="() => OnAddItem(sku)" disabled="@_checkedOut">Add @sku</button>
    }
    <span class="hub-controls-sep"></span>
    <button @onclick="OnCheckout" disabled="@(_checkedOut || _basket.Count == 0)">Check out (@_basket.Count)</button>
    <button @onclick="OnNewCart">New cart</button>
</section>

@if (!string.IsNullOrEmpty(_message))
{
    <div class="hub-message">@_message</div>
}

<div class="hub-grid">
    <div class="hub-left">
        <h2>Basket <span class="hub-orders-meta">state-only, raises no Event</span></h2>
        @if (_basket.Count == 0)
        {
            <p class="hub-empty-small">Empty. Add items above — each AddItemToCart accumulates durable state and raises no Event, so the Demo hub stays quiet.</p>
        }
        else
        {
            <ul class="playground-basket">
                @foreach (var sku in _basket)
                {
                    <li><code>@sku</code></li>
                }
            </ul>
        }

        <h2>Checked-out cart <span class="hub-orders-meta">CheckedOutCart projection</span></h2>
        @if (_checkedOutCart is null)
        {
            <p class="hub-empty-small">No checkout yet. This read model is written by a Table Projection Builder once you check out.</p>
        }
        else
        {
            <table class="hub-orders">
                <tbody>
                    <tr><td>Item count</td><td>@_checkedOutCart.ItemCount</td></tr>
                    <tr><td>SKUs</td><td><code>@_checkedOutCart.Skus</code></td></tr>
                </tbody>
            </table>
        }
    </div>

    <div class="hub-right">
        <h2>Bridged order <span class="hub-orders-meta">keyed by the cart id</span></h2>
        @if (_orderStatus is null)
        {
            <p class="hub-empty-small">No order yet. On checkout the bridge Saga places one Order carrying the basket; it then flows through payment and fulfillment.</p>
        }
        else
        {
            <table class="hub-orders">
                <tbody>
                    <tr><td>Status</td><td>@_orderStatus.Status</td></tr>
                    <tr><td>Items</td><td>@_orderStatus.ItemCount</td></tr>
                    <tr><td>Submitted</td><td>@FormatTime(_orderStatus.SubmittedAt)</td></tr>
                    <tr><td>Payment authorized</td><td>@FormatTime(_orderStatus.AuthorizedAt)</td></tr>
                    <tr><td>Fulfilled</td><td>@FormatTime(_orderStatus.FulfilledAt)</td></tr>
                    <tr><td>Shipped</td><td>@FormatTime(_orderStatus.ShippedAt)</td></tr>
                </tbody>
            </table>
        }
    </div>
</div>

@code {
    static readonly string[] Catalogue = ["WIDGET", "GADGET", "GIZMO"];

    Guid _cartId = Guid.NewGuid();
    readonly List<string> _basket = [];
    bool _checkedOut;
    CheckedOutCartRow? _checkedOutCart;
    OrderStatusRow? _orderStatus;
    string _message = "";

    PeriodicTimer? _timer;
    CancellationTokenSource? _cts;

    protected override void OnInitialized()
    {
        _cts = new CancellationTokenSource();
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        _ = PollAsync(_cts.Token);
    }

    async Task PollAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (await _timer!.WaitForNextTickAsync(cancellationToken))
            {
                await RefreshAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    async Task RefreshAsync()
    {
        // Nothing downstream exists until checkout raises its Event.
        if (!_checkedOut)
        {
            return;
        }

        try
        {
            _checkedOutCart = await CheckedOutCarts.GetAsync(_cartId.ToString(), "cart");
            _orderStatus = await OrdersByStatus.GetAsync(_cartId.ToString(), "status");
        }
        catch
        {
            // Read-only refresh path: a transient store hiccup must not surface
            // as a Blazor error boundary in the demo.
        }
    }

    async Task OnAddItem(string sku)
    {
        var result = await Sender.SendAsync(new AddItemToCartCommand(_cartId, sku));
        if (result is EdictCommandResult.Accepted)
        {
            _basket.Add(sku);
            _message = $"Added {sku} — one AddItemToCart Command, no Event raised.";
        }
        else
        {
            _message = Describe("AddItemToCart", result);
        }
    }

    async Task OnCheckout()
    {
        var result = await Sender.SendAsync(new CheckoutCartCommand(_cartId));
        if (result is EdictCommandResult.Accepted)
        {
            _checkedOut = true;
            _message = "Checked out — one CartCheckedOutEvent carries the whole basket; the bridge Saga is placing the Order.";
        }
        else
        {
            _message = Describe("CheckoutCart", result);
        }
    }

    void OnNewCart()
    {
        _cartId = Guid.NewGuid();
        _basket.Clear();
        _checkedOut = false;
        _checkedOutCart = null;
        _orderStatus = null;
        _message = "Started a fresh cart.";
    }

    static string FormatShort(Guid id) => id.ToString("N")[..8];

    static string FormatTime(DateTimeOffset? when) =>
        when?.ToLocalTime().ToString("HH:mm:ss") ?? "—";

    static string Describe(string label, EdictCommandResult result) =>
        result is EdictCommandResult.Rejected rejected
            ? $"{label} rejected: {string.Join(", ", rejected.Reasons.Select(reason => reason.Code))}."
            : $"{label} accepted.";

    public void Dispose()
    {
        _cts?.Cancel();
        _timer?.Dispose();
        _cts?.Dispose();
    }
}
