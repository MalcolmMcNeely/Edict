@page "/playground"
@using Orleans
@using Edict.Contracts.Commands
@using Edict.Contracts.Sending
@using Edict.Core.Sagas
@using Sample.Contracts.Cart.Commands
@using Sample.Contracts.Cart.Projections
@using Sample.Contracts.Orders.Projections
@using Sample.Contracts.Settlement.Commands
@using Sample.Domain.Settlement.Sagas
@inject IEdictSender Sender
@inject IClusterClient ClusterClient
@inject IEdictProjectionReader<CheckedOutCartRow> CheckedOutCarts
@inject IEdictProjectionReader<OrderStatusRow> OrdersByStatus
@implements IDisposable

<PageTitle>Edict — Playground</PageTitle>

<h1>Playground</h1>

<p class="tagline">Step a workflow one Command at a time and read your own write straight back. Every <code>Accepted</code> carries a cursor; feeding it to a Projection read waits, briefly and boundedly, until the work that Command set in motion is visible, so the row comes back on the same click with no poll and no lag. That is the contrast with the Demo hub, which reads with no cursor and shows the eventual-consistency gap. Build a cart with state-only Commands (no Event, no downstream traffic), then check out: a bridge Saga turns the whole basket into an Order that flows through payment and fulfillment.</p>

<section class="hub-controls">
    <span class="playground-cart">Cart <code>@FormatShort(_cartId)</code></span>
    <span class="hub-controls-sep"></span>
    @foreach (var sku in Catalogue)
    {
        <button @onclick="() => OnAddItem(sku)" disabled="@_checkedOut">Add @sku</button>
    }
    <span class="hub-controls-sep"></span>
    <button @onclick="OnCheckout" disabled="@(_checkedOut || _basket.Count == 0)">Check out (@_basket.Count)</button>
    <button @onclick="OnRefreshOrder" disabled="@(!_checkedOut)">Refresh order</button>
    <button @onclick="OnNewCart">New cart</button>
</section>

@if (!string.IsNullOrEmpty(_message))
{
    <div class="hub-message">@_message</div>
}

<div class="hub-grid">
    <div class="hub-left">
        <h2>Basket <span class="hub-orders-meta">state-only, raises no Event</span></h2>
        @if (_basket.Count == 0)
        {
            <p class="hub-empty-small">Empty. Add items above — each AddItemToCart accumulates durable state and raises no Event, so the Demo hub stays quiet.</p>
        }
        else
        {
            <ul class="playground-basket">
                @foreach (var sku in _basket)
                {
                    <li><code>@sku</code></li>
                }
            </ul>
        }

        <h2>Checked-out cart <span class="hub-orders-meta">CheckedOutCart projection</span></h2>
        @if (_checkedOutCart is null)
        {
            <p class="hub-empty-small">No checkout yet. A List Projection Builder writes this read model once you check out, and the cursor on <code>Accepted</code> reads it straight back on the same click.</p>
        }
        else
        {
            <table class="hub-orders">
                <tbody>
                    <tr><td>Item count</td><td>@_checkedOutCart.ItemCount</td></tr>
                    <tr><td>SKUs</td><td><code>@_checkedOutCart.Skus</code></td></tr>
                </tbody>
            </table>
        }
    </div>

    <div class="hub-right">
        <h2>Bridged order <span class="hub-orders-meta">keyed by the cart id</span></h2>
        @if (_orderStatus is null)
        {
            <p class="hub-empty-small">No order yet. On checkout the cursor reads the freshly placed Order straight back; it then flows through payment and fulfillment, and a barrier Saga closes it once both have landed. That downstream lifecycle is genuinely eventual, so press Refresh order (a plain cursorless read) to watch it advance.</p>
        }
        else
        {
            <table class="hub-orders">
                <tbody>
                    <tr><td>Status</td><td>@_orderStatus.Status</td></tr>
                    <tr><td>Items</td><td>@_orderStatus.ItemCount</td></tr>
                    <tr><td>Submitted</td><td>@FormatTime(_orderStatus.SubmittedAt)</td></tr>
                    <tr><td>Payment authorized</td><td>@FormatTime(_orderStatus.AuthorizedAt)</td></tr>
                    <tr><td>Fulfilled</td><td>@FormatTime(_orderStatus.FulfilledAt)</td></tr>
                    <tr><td>Shipped</td><td>@FormatTime(_orderStatus.ShippedAt)</td></tr>
                    <tr><td>Closed</td><td>@FormatTime(_orderStatus.ClosedAt)</td></tr>
                </tbody>
            </table>
        }
    </div>
</div>

<h2 class="playground-section">Gateway settlement <span class="hub-orders-meta">EdictSchedule — a recurring poll on the Saga's own clock</span></h2>

<p class="tagline">A Saga can poll on a recurring EdictSchedule, the same scheduling surface a Command Handler has. Begin a settlement and watch the poll count climb on the demo-fast cadence; the count and terminal outcome are read straight off the Saga's durable Progress, so the Saga is the single source of truth with no extra projection. Settle runs uncapped and confirms after the second poll. Abandon caps the schedule below one poll cadence, so the schedule-timeout compensation abandons it.</p>

<section class="hub-controls">
    <span class="playground-cart">Payment <code>@FormatShort(_paymentId)</code></span>
    <span class="hub-controls-sep"></span>
    <button @onclick="OnBeginSettle" disabled="@_settlementBegun">Settle</button>
    <button @onclick="OnBeginAbandon" disabled="@_settlementBegun">Abandon (short cap)</button>
    <button @onclick="OnNewSettlement">New settlement</button>
</section>

<div class="hub-grid">
    <div class="hub-left">
        <h2>Saga progress <span class="hub-orders-meta">GetEdictProgressAsync</span></h2>
        @if (!_settlementBegun)
        {
            <p class="hub-empty-small">No settlement yet. Begin one above; the Saga arms an EdictSchedule and starts polling the gateway on the demo-fast cadence.</p>
        }
        else
        {
            <table class="hub-orders">
                <tbody>
                    <tr><td>Polls</td><td>@(_settlementProgress?.Polls ?? 0)</td></tr>
                    <tr><td>Outcome</td><td>@OutcomeLabel(_settlementProgress?.Outcome)</td></tr>
                </tbody>
            </table>
        }
    </div>
</div>

@code {
    static readonly string[] Catalogue = ["WIDGET", "GADGET", "GIZMO"];

    Guid _cartId = Guid.NewGuid();
    readonly List<string> _basket = [];
    bool _checkedOut;
    CheckedOutCartRow? _checkedOutCart;
    OrderStatusRow? _orderStatus;
    string _message = "";

    Guid _paymentId = Guid.NewGuid();
    bool _settlementBegun;
    GatewaySettlementProgress? _settlementProgress;

    PeriodicTimer? _timer;
    CancellationTokenSource? _cts;

    protected override void OnInitialized()
    {
        _cts = new CancellationTokenSource();
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        _ = PollAsync(_cts.Token);
    }

    async Task PollAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (await _timer!.WaitForNextTickAsync(cancellationToken))
            {
                await RefreshAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    async Task RefreshAsync()
    {
        // Only the settlement schedule polls on a timer: watching its poll count
        // climb on a recurring cadence is inherently time-driven. The cart and
        // order panels read through the cursor instead (see OnCheckout), so they
        // have no background poll.
        await RefreshSettlementAsync();
    }

    async Task RefreshSettlementAsync()
    {
        if (!_settlementBegun)
        {
            return;
        }

        try
        {
            // The Saga is the single source of truth: its durable Progress carries
            // the poll count and outcome, read through the same accessor the tests use.
            var saga = ClusterClient.GetGrain<IEdictSaga>(_paymentId, typeof(GatewaySettlementSaga).FullName);
            _settlementProgress = (GatewaySettlementProgress)await saga.GetEdictProgressAsync();
        }
        catch
        {
            // Read-only refresh path: a transient grain hiccup must not surface
            // as a Blazor error boundary in the demo.
        }
    }

    async Task OnAddItem(string sku)
    {
        var result = await Sender.SendAsync(new AddItemToCartCommand(_cartId, sku));
        if (result is EdictCommandResult.Accepted)
        {
            _basket.Add(sku);
            _message = $"Added {sku} — one AddItemToCart Command, no Event raised.";
        }
        else
        {
            _message = Describe("AddItemToCart", result);
        }
    }

    async Task OnCheckout()
    {
        var result = await Sender.SendAsync(new CheckoutCartCommand(_cartId));
        if (result is EdictCommandResult.Accepted accepted)
        {
            _checkedOut = true;

            // Read-your-writes: feed the cursor the Command set in motion straight
            // into the reads. Each waits, briefly and boundedly, until that work is
            // visible, so both rows come back on this same click. The correlation
            // propagates through the bridge Saga, so the cursor also reaches the
            // freshly placed Order, not just the checked-out cart.
            var cursor = accepted.Cursor;
            var cart = await CheckedOutCarts.GetAsync(_cartId.ToString(), "cart", after: cursor);
            var order = await OrdersByStatus.GetAsync(_cartId.ToString(), "status", after: cursor);
            _checkedOutCart = cart.Row;
            _orderStatus = order.Row;
            _message = cart.Status == EdictReadStatus.CursorReached
                ? "Checked out. The cursor on Accepted read the cart and the placed Order straight back: no poll, no lag."
                : "Checked out. The read timed out before the projection caught up, so this is the latest available row.";
        }
        else
        {
            _message = Describe("CheckoutCart", result);
        }
    }

    async Task OnRefreshOrder()
    {
        try
        {
            // The plain poll path: no cursor, answers from the current store state.
            // The Order's downstream lifecycle (payment, fulfillment, shipping) is
            // genuinely eventual, so this is how a visitor watches it advance.
            _checkedOutCart = (await CheckedOutCarts.GetAsync(_cartId.ToString(), "cart")).Row;
            _orderStatus = (await OrdersByStatus.GetAsync(_cartId.ToString(), "status")).Row;
            _message = "Refreshed the Order with a plain cursorless read, the same path the Demo hub polls on.";
        }
        catch
        {
            // Read-only refresh path: a transient store hiccup must not surface
            // as a Blazor error boundary in the demo.
        }
    }

    void OnNewCart()
    {
        _cartId = Guid.NewGuid();
        _basket.Clear();
        _checkedOut = false;
        _checkedOutCart = null;
        _orderStatus = null;
        _message = "Started a fresh cart.";
    }

    async Task OnBeginSettle()
    {
        // Uncapped: the schedule is bounded only by the Saga's own lifetime, so it
        // polls until the gateway settles and confirms on the second poll.
        var result = await Sender.SendAsync(new BeginGatewaySettlementCommand(_paymentId, PollTimeoutSeconds: 0));
        if (result is EdictCommandResult.Accepted)
        {
            _settlementBegun = true;
            _message = "Settlement begun uncapped. The Saga is polling; it confirms after the second poll.";
        }
        else
        {
            _message = Describe("BeginGatewaySettlement", result);
        }
    }

    async Task OnBeginAbandon()
    {
        // A one-second cap sits below the poll cadence, so the schedule times out
        // before the first poll and the compensation abandons the settlement.
        var result = await Sender.SendAsync(new BeginGatewaySettlementCommand(_paymentId, PollTimeoutSeconds: 1));
        if (result is EdictCommandResult.Accepted)
        {
            _settlementBegun = true;
            _message = "Settlement begun with a cap below the poll cadence. The schedule times out and compensates.";
        }
        else
        {
            _message = Describe("BeginGatewaySettlement", result);
        }
    }

    void OnNewSettlement()
    {
        _paymentId = Guid.NewGuid();
        _settlementBegun = false;
        _settlementProgress = null;
        _message = "Started a fresh settlement.";
    }

    static string OutcomeLabel(GatewaySettlementOutcome? outcome) => outcome switch
    {
        GatewaySettlementOutcome.Settled => "Settled",
        GatewaySettlementOutcome.Abandoned => "Abandoned (schedule-timeout compensation)",
        _ => "Polling…",
    };

    static string FormatShort(Guid id) => id.ToString("N")[..8];

    static string FormatTime(DateTimeOffset? when) =>
        when?.ToLocalTime().ToString("HH:mm:ss") ?? "—";

    static string Describe(string label, EdictCommandResult result) =>
        result is EdictCommandResult.Rejected rejected
            ? $"{label} rejected: {string.Join(", ", rejected.Reasons.Select(reason => reason.Code))}."
            : $"{label} accepted.";

    public void Dispose()
    {
        _cts?.Cancel();
        _timer?.Dispose();
        _cts?.Dispose();
    }
}
