<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <RootNamespace>Sample.Domain</RootNamespace>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../Sample.Contracts/Sample.Contracts.csproj" />
        <ProjectReference Include="../../Edict/Edict.Core/Edict.Core.csproj" />
        <!--
          Generator runs over this assembly — emits IOrderGrain, Dispatch,
          the EdictRouteRegistrar, and [assembly: EdictRoutes(...)]. The
          handlers live here; the substrate-specific Sample.Azure.Silo and
          Sample.KafkaPostgres.Silo hosts pick the routes up via reference
          and AppDomain scan. ReferenceOutputAssembly=false: we only need
          the generator to run, not to link it.
        -->
        <ProjectReference Include="../../Edict/Edict.Generators/Edict.Generators.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
        <ProjectReference Include="../../Edict/Edict.Analyzers/Edict.Analyzers.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
    </ItemGroup>

</Project>
