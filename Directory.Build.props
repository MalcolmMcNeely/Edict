<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    Centralised package-version families. Bump one property here to move every
    package in the family together; Directory.Packages.props (imported after
    this file) reads these. One-off packages keep literal versions there.
  -->
  <PropertyGroup>
    <OrleansVersion>10.2.0</OrleansVersion>
    <MicrosoftExtensionsRuntimeVersion>10.0.9</MicrosoftExtensionsRuntimeVersion>
    <AspNetCoreVersion>10.0.9</AspNetCoreVersion>
    <MicrosoftExtensionsLibrariesVersion>10.7.0</MicrosoftExtensionsLibrariesVersion>
    <AspireVersion>13.4.5</AspireVersion>
    <OpenTelemetryVersion>1.16.0</OpenTelemetryVersion>
    <MessagePackVersion>3.1.7</MessagePackVersion>
    <TestcontainersVersion>4.12.0</TestcontainersVersion>
    <FluentValidationVersion>12.1.1</FluentValidationVersion>
  </PropertyGroup>

  <!--
    The Roslyn 5.0 compiler only honours [InterceptsLocation] attributes whose
    containing namespace is listed in InterceptorsNamespaces. The unified
    generator emits its Send/Raise/Dispatch interceptor stubs into
    Edict.Generated; for the in-repo ProjectReference path we register that
    namespace here to mirror what the shipped Edict.Core.targets does for
    PackageReference consumers. Setting EdictInterceptorsEnabled=false makes
    the generator short-circuit emission and reverts every call site to the
    registrar.
  -->

  <PropertyGroup>
    <EdictInterceptorsEnabled Condition="'$(EdictInterceptorsEnabled)' == ''">true</EdictInterceptorsEnabled>
    <InterceptorsNamespaces Condition="'$(EdictInterceptorsEnabled)' == 'true'">$(InterceptorsNamespaces);Edict.Generated</InterceptorsNamespaces>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="EdictInterceptorsEnabled" />
  </ItemGroup>

  <!--
    The shipping packages opt in via <IsPackable>true</IsPackable> in their
    own csproj; every other csproj inherits the default-false here so
    dotnet pack only touches the shipping surface. Shipping-package metadata
    + MinVer/SourceLink wiring live in Directory.Build.targets so they
    evaluate after the csproj's own PropertyGroup sets IsPackable.
  -->
  <PropertyGroup>
    <IsPackable Condition="'$(IsPackable)' == ''">false</IsPackable>
  </PropertyGroup>

  <!--
    Edict.Mcp registers the SDK's MSBuild via MSBuildLocator.RegisterDefaults()
    before any MSBuild type loads, so the MSBuild engine assemblies that Roslyn's
    Workspaces.MSBuild drags in are resolved from the SDK at runtime, not from the
    copies in the output folder. Microsoft.Build.Locator's MSBL001 check errors on
    those copies; opt out since the Locator registration is what owns resolution.
    The check's target only runs where Build.Locator is referenced (Edict.Mcp and
    the projects that reference it), so this property is inert elsewhere.
  -->
  <PropertyGroup>
    <DisableMSBuildAssemblyCopyCheck>true</DisableMSBuildAssemblyCopyCheck>
  </PropertyGroup>

  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
  </ItemGroup>

</Project>
