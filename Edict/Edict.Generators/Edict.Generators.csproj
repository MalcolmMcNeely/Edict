<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <!-- RS2008: release tracking not required for internal library -->
        <NoWarn>$(NoWarn);RS2008</NoWarn>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <!--
      This generator assembly deliberately does NOT reference Edict.Contracts
      or any other net10.0 Edict assembly. It recognises Edict's annotations
      and base types by fully-qualified name in the consumer's compilation,
      which keeps it loadable on netstandard2.0 SDK hosts.
    -->
    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Edict.Generators.Tests" />
    </ItemGroup>

</Project>
