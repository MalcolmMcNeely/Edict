<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <PackageId>Edict.Contracts</PackageId>
        <Description>Consumer-facing contracts for the Edict CQRS framework: command and event base types, route-key attributes, and rejection model. Reference this from your domain assembly to share contracts with your handlers and tests.</Description>
        <PackageTags>edict;cqrs;orleans;contracts</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <!--
          Attributes-only package (no serializer runtime) so the contracts
          assembly stays Orleans-free. Version tracks the MessagePack runtime
          that Microsoft.Orleans.Serialization.MessagePack 9.2.1 pulls.
        -->
        <PackageReference Include="MessagePack.Annotations" />
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Edict.Core" />
        <InternalsVisibleTo Include="Edict.Azure.Streaming" />
        <InternalsVisibleTo Include="Edict.Azure.Persistence" />
        <InternalsVisibleTo Include="Edict.Postgres" />
        <InternalsVisibleTo Include="Edict.Testing" />
        <InternalsVisibleTo Include="Edict.Core.Tests" />
        <InternalsVisibleTo Include="Edict.Architecture.Tests" />
        <InternalsVisibleTo Include="Edict.Azure.Tests" />
        <InternalsVisibleTo Include="Edict.Postgres.Tests" />
        <InternalsVisibleTo Include="Edict.Kafka.Tests" />
        <InternalsVisibleTo Include="Edict.Tests.Conformance" />
        <InternalsVisibleTo Include="Edict.Telemetry.Tests" />
    </ItemGroup>

</Project>
