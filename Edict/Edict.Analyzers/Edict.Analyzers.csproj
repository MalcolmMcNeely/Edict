<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <!-- RS2008: release tracking not required for internal library. -->
        <!-- RS1038: analyzers and the PersistedStateContractCodeFixProvider
             deliberately ship in one assembly (Roslyn-side code is kept in
             two leaf assemblies, not four). Roslyn 5.0 raised this rule's
             visibility; the topology choice is intentional. -->
        <NoWarn>$(NoWarn);RS2008;RS1038</NoWarn>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <!--
      This analyzer assembly deliberately does NOT reference Edict.Contracts
      or any other net10.0 Edict assembly. It recognises Edict's annotations
      and base types by fully-qualified name in the consumer's compilation,
      which keeps it loadable on netstandard2.0 SDK hosts.
    -->
    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" PrivateAssets="all" />
    </ItemGroup>

    <!-- Single-source the FQN constants; compile-linked into both Roslyn
         assemblies (Edict.Analyzers and Edict.Generators). -->
    <ItemGroup>
        <Compile Include="../Edict.Generators/EdictWellKnownNames.cs" />
    </ItemGroup>

</Project>
